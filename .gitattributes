# Repo-wide line-ending policy: every text file is LF in the index and in the
# working tree, on every platform.
#
# `text=auto` lets git detect text files and normalise them to LF in the index;
# `eol=lf` additionally checks them out as LF, so a Windows checkout can neither
# commit CRLF nor produce one on renormalisation. This is a house rule, not a
# Bible rule.
* text=auto eol=lf
